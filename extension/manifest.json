{
  "manifest_version": 3,
  "name": "Client Hunter",
  "version": "0.1.0",
  "description": "Collect leads and import to CRM - Source Adapter architecture",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Client Hunter" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://*/*","http://*/*"], "js": ["content.js"] }]
}
